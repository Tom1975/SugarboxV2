{
  // Copiez ce fichier dans .vscode/settings.json à la racine de votre projet.
  // Adaptez les valeurs à votre projet.

  // ─── Projet Z80 ─────────────────────────────────────────────────────────

  // Fichier ASM principal (relatif à la racine du workspace).
  // Utilisé par la tâche "RASM: assemble".
  "z80debug.entryPoint": "src/main.asm",

  // Nom de base des fichiers générés dans build/.
  // Ex: "mygame" → build/mygame.dsk, build/mygame.rasm
  "z80debug.buildName": "main",

  // ─── Chemins des outils ─────────────────────────────────────────────────
  // Définir SUGARBOX et RASM ici évite de les hardcoder dans launch.json et
  // tasks.json. Chaque développeur peut surcharger ces valeurs dans ses
  // settings utilisateur (~/.config/Code/User/settings.json).
  //
  // RASM : si rasm est dans votre PATH système, vous pouvez omettre RASM.
  //        Sinon, indiquez le chemin complet vers le binaire.
  "terminal.integrated.env.linux": {
    "SUGARBOX": "/chemin/vers/Sugarbox",
    "RASM": "/chemin/vers/rasm"
  },
  "terminal.integrated.env.osx": {
    "SUGARBOX": "/chemin/vers/Sugarbox",
    "RASM": "/chemin/vers/rasm"
  },
  "terminal.integrated.env.windows": {
    "SUGARBOX": "C:\\chemin\\vers\\Sugarbox.exe",
    "RASM": "C:\\chemin\\vers\\rasm.exe"
  },

  // ─── Association des fichiers ────────────────────────────────────────────
  // Associe les .asm à la syntaxe de l'extension recommandée (extensions.json).
  "files.associations": {
    "*.asm": "asm-collection"
  }
}
