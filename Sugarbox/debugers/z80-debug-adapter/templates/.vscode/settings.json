{
  // Copiez ce fichier dans .vscode/settings.json à la racine de votre projet.
  // Adaptez les valeurs à votre projet.
  //
  // Vous pouvez aussi lancer "Z80 Debug: Configure workspace" (Ctrl+Shift+P)
  // pour renseigner automatiquement les chemins Sugarbox et RASM.

  // ─── Projet Z80 ─────────────────────────────────────────────────────────

  // Fichier ASM principal (relatif à la racine du workspace).
  "z80debug.entryPoint": "src/main.asm",

  // Nom de base des fichiers générés dans build/.
  // Ex: "mygame" → build/mygame.sna, build/mygame.rasm
  "z80debug.buildName": "main",

  // ─── Chemins des outils ──────────────────────────────────────────────────
  // Renseignez ces chemins ou lancez "Z80 Debug: Configure workspace".

  // Chemin vers le binaire Sugarbox.
  "z80debug.sugarbox": "",

  // Chemin vers le binaire RASM (ou juste "rasm" s'il est dans le PATH).
  "z80debug.rasm": "rasm",

  // ─── Association des fichiers ────────────────────────────────────────────
  "files.associations": {
    "*.asm": "asm-collection"
  }
}
