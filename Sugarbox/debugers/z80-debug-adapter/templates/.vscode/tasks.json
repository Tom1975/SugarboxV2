{
  // Copiez ce fichier dans .vscode/tasks.json à la racine de votre projet.
  //
  // Ce fichier utilise deux réglages VS Code définis dans settings.json :
  //   z80debug.entryPoint  — chemin relatif du fichier ASM principal (ex: "src/main.asm")
  //   z80debug.buildName   — nom de base des fichiers de sortie   (ex: "mygame")
  //
  // Ils sont définis dans .vscode/settings.json (voir le fichier settings.json fourni).
  "version": "2.0.0",
  "tasks": [

    // ─── Créer le dossier build ───────────────────────────────────────────────
    // Tâche utilitaire dont dépend "RASM: assemble".
    // Évite l'erreur si le dossier build/ n'existe pas encore.
    {
      "label": "Create build dir",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build'",
      "windows": {
        "command": "if not exist '${workspaceFolder}\\build' mkdir '${workspaceFolder}\\build'"
      },
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },

    // ─── Assemblage RASM ─────────────────────────────────────────────────────
    // Assemble ${z80debug.entryPoint} et génère dans build/ :
    //   <buildName>.dsk    image disque DSK (Drive A)
    //   <buildName>.rasm   fichier symboles super-symbol pour le debugger
    //
    // Prérequis : rasm dans le PATH (Linux/Mac: "rasm", Windows: "rasm.exe"),
    //             ou définir la variable d'env RASM avec le chemin complet.
    //
    // Flags RASM :
    //   -o  <prefix>   préfixe du fichier binaire de sortie
    //   -oi <file>     générer le snapshot .sna
    //   -rasm          générer le fichier super-symbol .rasm (labels + adresses)
    //   -sq            mode silencieux
    {
      "label": "RASM: assemble",
      "type": "shell",
      "command": "${env:RASM:-rasm}",
      "windows": {
        "command": "${env:RASM}"
      },
      "args": [
        "${workspaceFolder}/${config:z80debug.entryPoint}",
        "-o",   "${workspaceFolder}/build/${config:z80debug.buildName}",
        "-oi",  "${workspaceFolder}/build/${config:z80debug.buildName}.sna",
        "-rasm",
        "-sq"
      ],
      "dependsOn": ["Create build dir"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "rasm",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(Error|Warning).*line\\s+(\\d+).*file\\s+(.+):\\s+(.+)$",
          "severity": 1,
          "line": 2,
          "file": 3,
          "message": 4
        }
      }
    },

    // ─── Lancer Sugarbox manuellement (pour le mode Attach) ─────────────────
    // Utile si vous voulez démarrer l'émulateur à la main sans passer par F5.
    // Ouvre Sugarbox avec le serveur de debug activé, en pause au démarrage.
    // La variable SUGARBOX doit pointer vers le binaire (voir settings.json).
    {
      "label": "Sugarbox: start debug server",
      "type": "shell",
      "command": "${env:SUGARBOX}",
      "args": [
        "--debug",
        "--debug_server", "1234"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }

  ]
}
