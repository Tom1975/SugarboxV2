{
  // Copiez ce fichier dans .vscode/tasks.json à la racine de votre projet.
  //
  // Ce fichier utilise les réglages VS Code définis dans settings.json :
  //   z80debug.entryPoint  — chemin relatif du fichier ASM principal (ex: "src/main.asm")
  //   z80debug.buildName   — nom de base des fichiers de sortie   (ex: "mygame")
  //   z80debug.rasm        — chemin vers le binaire RASM
  //   z80debug.sugarbox    — chemin vers le binaire Sugarbox
  //
  // Lancez "Z80 Debug: Configure workspace" (Ctrl+Shift+P) pour renseigner
  // automatiquement les chemins Sugarbox et RASM.
  "version": "2.0.0",
  "tasks": [

    // ─── Créer le dossier build ───────────────────────────────────────────────
    {
      "label": "Create build dir",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build'",
      "windows": {
        "command": "New-Item -ItemType Directory -Force -Path '${workspaceFolder}\\build' | Out-Null"
      },
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },

    // ─── Assemblage RASM ─────────────────────────────────────────────────────
    // Flags RASM :
    //   -o  <prefix>   préfixe du fichier binaire de sortie
    //   -oi <file>     générer le snapshot .sna
    //   -rasm          générer le fichier super-symbol .rasm (labels + adresses)
    //   -sq            mode silencieux
    {
      "label": "RASM: assemble",
      "type": "shell",
      "command": "${config:z80debug.rasm}",
      "args": [
        "${workspaceFolder}/${config:z80debug.entryPoint}",
        "-o",   "${workspaceFolder}/build/${config:z80debug.buildName}",
        "-oi",  "${workspaceFolder}/build/${config:z80debug.buildName}.sna",
        "-rasm",
        "-sq"
      ],
      "dependsOn": ["Create build dir"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "rasm",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(Error|Warning).*line\\s+(\\d+).*file\\s+(.+):\\s+(.+)$",
          "severity": 1,
          "line": 2,
          "file": 3,
          "message": 4
        }
      }
    },

    // ─── Lancer Sugarbox manuellement (pour le mode Attach) ─────────────────
    // Ouvre Sugarbox avec le serveur de debug activé, en pause au démarrage.
    {
      "label": "Sugarbox: start debug server",
      "type": "shell",
      "command": "${config:z80debug.sugarbox}",
      "args": [
        "--debug",
        "--debug_server", "1234"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }

  ]
}
