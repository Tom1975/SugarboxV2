{
  // Copiez ce fichier dans .vscode/launch.json à la racine de votre projet.
  //
  // Les chemins vers le .dsk et le fichier symboles utilisent le réglage
  // z80debug.buildName défini dans .vscode/settings.json.
  //
  // Le binaire Sugarbox est lu depuis la variable d'environnement SUGARBOX.
  // Voir .vscode/settings.json pour la définir sans modifier ce fichier.
  "version": "0.2.0",
  "configurations": [

    // ─── Mode Launch : disque DSK ────────────────────────────────────────────
    // Lance Sugarbox, insère le disque et brise à PC=0x0000.
    // Réassemble automatiquement avant de démarrer (preLaunchTask).
    {
      "type": "z80",
      "request": "launch",
      "name": "Amstrad CPC - Launch (disk)",
      "emulator": "${env:SUGARBOX}",
      "disk": "${workspaceFolder}/build/${config:z80debug.buildName}.dsk",
      "symbolFile": "${workspaceFolder}/build/${config:z80debug.buildName}.rasm",
      "port": 1234,
      "hideEmulator": false,
      "preLaunchTask": "RASM: assemble"
    },

    // ─── Mode Launch : snapshot ──────────────────────────────────────────────
    // Lance Sugarbox et restaure un état sauvegardé (utile pour reprendre
    // le debug à un point précis sans rejouer le chargement du programme).
    {
      "type": "z80",
      "request": "launch",
      "name": "Amstrad CPC - Launch (snapshot)",
      "emulator": "${env:SUGARBOX}",
      "snapshot": "${workspaceFolder}/build/${config:z80debug.buildName}.sna",
      "symbolFile": "${workspaceFolder}/build/${config:z80debug.buildName}.rasm",
      "port": 1234,
      "preLaunchTask": "RASM: assemble"
    },

    // ─── Mode Attach ────────────────────────────────────────────────────────
    // Se connecte à un Sugarbox déjà lancé avec :
    //   $SUGARBOX --debug --debug_server 1234
    // ou via la tâche "Sugarbox: start debug server".
    {
      "type": "z80",
      "request": "attach",
      "name": "Amstrad CPC - Attach",
      "port": 1234,
      "symbolFile": "${workspaceFolder}/build/${config:z80debug.buildName}.rasm"
    }

  ]
}
