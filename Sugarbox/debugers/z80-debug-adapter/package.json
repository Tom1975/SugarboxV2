{
  "name": "z80-debug",
  "displayName": "Z80 Debug Adapter",
  "description": "Debug adapter for Z80 emulators (RASM + SugarboxV2)",
  "version": "0.0.1",
  "publisher": "thomas-guillemin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tom1975/SugarboxV2"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebug",
    "onStartupFinished"
  ],
  "main": "./out/main.js",
  "contributes": {
    "configuration": {
      "title": "Z80 Debug",
      "properties": {
        "z80debug.entryPoint": {
          "type": "string",
          "default": "src/main.asm",
          "description": "Main ASM source file to assemble (relative to workspace root). Used by the build task."
        },
        "z80debug.buildName": {
          "type": "string",
          "default": "main",
          "description": "Base name for build outputs (e.g. \"mygame\" → build/mygame.dsk, build/mygame.rasm). Used by the build task and launch config."
        },
        "z80debug.sugarbox": {
          "type": "string",
          "default": "",
          "description": "Path to the Sugarbox emulator binary (e.g. C:\\\\Tools\\\\Sugarbox.exe or /usr/local/bin/Sugarbox)."
        },
        "z80debug.rasm": {
          "type": "string",
          "default": "rasm",
          "description": "Path to the RASM assembler binary (e.g. C:\\\\Tools\\\\rasm_w64.exe or rasm if on PATH)."
        }
      }
    },
    "languages": [
      {
        "id": "z80-disasm",
        "aliases": ["Z80 Disassembly"],
        "extensions": [".z80disasm"],
        "mimetypes": ["text/x-z80-disasm"]
      }
    ],
    "grammars": [
      {
        "language": "z80-disasm",
        "scopeName": "source.z80disasm",
        "path": "./syntaxes/z80-disasm.tmGrammar.json"
      }
    ],
    "commands": [
      {
        "command": "z80debug.configure",
        "title": "Z80 Debug: Configure workspace (Sugarbox & RASM paths)"
      },
      {
        "command": "z80debug.openDisasmAt",
        "title": "Z80 Debug: Open Disassembly at Address…",
        "category": "Z80 Debug"
      },
      {
        "command": "z80debug.openMemoryAt",
        "title": "Z80 Debug: Open Memory View at Address…",
        "category": "Z80 Debug"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "z80debug.openDisasmAt",
          "when": "debugState == 'stopped'",
          "group": "z80debug@1"
        },
        {
          "command": "z80debug.openMemoryAt",
          "when": "debugState == 'stopped'",
          "group": "z80debug@2"
        }
      ],
      "debug/variables/context": [
        {
          "command": "z80debug.openMemoryAt",
          "when": "debugType == 'z80' && debugState == 'stopped'",
          "group": "z80debug@1"
        },
        {
          "command": "z80debug.openDisasmAt",
          "when": "debugType == 'z80' && debugState == 'stopped'",
          "group": "z80debug@2"
        }
      ],
      "commandPalette": [
        {
          "command": "z80debug.openDisasmAt",
          "when": "debugState == 'stopped'"
        },
        {
          "command": "z80debug.openMemoryAt",
          "when": "debugState == 'stopped'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "z80debug.openDisasmAt",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "debugState == 'stopped'"
      },
      {
        "command": "z80debug.openMemoryAt",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "debugState == 'stopped'"
      }
    ],
    "debuggers": [
      {
        "type": "z80",
        "label": "Z80 Emulator",
        "program": "./out/main.js",
        "runtime": "node",
        "languages": [
          "asm"
        ],
        "initialConfigurations": [
          {
            "type": "z80",
            "request": "launch",
            "name": "Amstrad CPC - Launch",
            "emulator": "${config:z80debug.sugarbox}",
            "disk": "${workspaceFolder}/build/${config:z80debug.buildName}.dsk",
            "symbolFile": "${workspaceFolder}/build/${config:z80debug.buildName}.rasm",
            "port": 1234,
            "hideEmulator": false,
            "preLaunchTask": "RASM: assemble"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Amstrad CPC: Launch with disk (RASM)",
            "description": "Start Sugarbox, insert a .dsk and break at entry point",
            "body": {
              "type": "z80",
              "request": "launch",
              "name": "Amstrad CPC - Launch",
              "emulator": "^\"\\${config:z80debug.sugarbox}\"",
              "disk": "^\"\\${workspaceFolder}/build/\\${config:z80debug.buildName}.dsk\"",
              "symbolFile": "^\"\\${workspaceFolder}/build/\\${config:z80debug.buildName}.rasm\"",
              "port": 1234,
              "hideEmulator": false,
              "preLaunchTask": "RASM: assemble"
            }
          },
          {
            "label": "Amstrad CPC: Launch with snapshot",
            "description": "Start Sugarbox and load a .sna snapshot",
            "body": {
              "type": "z80",
              "request": "launch",
              "name": "Amstrad CPC - Snapshot",
              "emulator": "^\"\\${config:z80debug.sugarbox}\"",
              "snapshot": "^\"\\${workspaceFolder}/build/\\${config:z80debug.buildName}.sna\"",
              "symbolFile": "^\"\\${workspaceFolder}/build/\\${config:z80debug.buildName}.rasm\"",
              "port": 1234,
              "hideEmulator": false
            }
          },
          {
            "label": "Amstrad CPC: Attach to running emulator",
            "description": "Attach to a Sugarbox already started with --debug_server 1234",
            "body": {
              "type": "z80",
              "request": "attach",
              "name": "Amstrad CPC - Attach",
              "port": 1234,
              "symbolFile": "^\"\\${workspaceFolder}/build/\\${config:z80debug.buildName}.rasm\""
            }
          }
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "emulator"
            ],
            "properties": {
              "emulator": {
                "type": "string",
                "description": "Path to the Sugarbox emulator binary"
              },
              "disk": {
                "type": "string",
                "description": "Path to the .dsk disk image to insert in drive A"
              },
              "tape": {
                "type": "string",
                "description": "Path to the .cdt/.wav tape image to insert"
              },
              "snapshot": {
                "type": "string",
                "description": "Path to the .sna snapshot to load"
              },
              "port": {
                "type": "number",
                "default": 1234,
                "description": "TCP debug server port (must match --debug_server value)"
              },
              "symbolFile": {
                "type": "string",
                "description": "RASM super-symbol file (.rasm) for label display in disassembly"
              },
              "sourceFile": {
                "type": "string",
                "description": "Main ASM source file (.asm) — used to enrich disassembly with comments"
              },
              "hideEmulator": {
                "type": "boolean",
                "default": false,
                "description": "Hide the emulator window (pass --hide to Sugarbox)"
              }
            }
          },
          "attach": {
            "required": [],
            "properties": {
              "port": {
                "type": "number",
                "default": 1234,
                "description": "TCP port of the running Z80 emulator"
              },
              "symbolFile": {
                "type": "string",
                "description": "RASM super-symbol file (.rasm) for label display in disassembly"
              },
              "sourceFile": {
                "type": "string",
                "description": "Main ASM source file (.asm) — used to enrich disassembly with comments"
              }
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/vscode": "^1.108.1",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-debugadapter": "^1.51.0",
    "vscode-debugprotocol": "^1.51.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
