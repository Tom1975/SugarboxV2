{
  "z80debug.entryPoint": "src/main.asm",
  "z80debug.buildName": "main",

  "terminal.integrated.env.linux": {
    "SUGARBOX": "/path/to/Sugarbox",
    "RASM": "/path/to/rasm"
  },
  "terminal.integrated.env.osx": {
    "SUGARBOX": "/path/to/Sugarbox",
    "RASM": "/path/to/rasm"
  },
  "terminal.integrated.env.windows": {
    "SUGARBOX": "C:\\path\\to\\Sugarbox.exe",
    "RASM": "C:\\path\\to\\rasm.exe"
  },

  "files.associations": {
    "*.asm": "asm-collection"
  }
}
